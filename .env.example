# Copy to `.env` and fill in. `.env` is gitignored, so real values never reach
# the repository; this file documents what each variable is for.

# ── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
# VITE_API_URL=https://jachiandmuchi.com/api

# ── Customer care phone (BUG-025) ────────────────────────────────────────────
# The single source for the tap-to-call number on Contact Us, Help, the footer,
# the MOI eye test page and the invoice. Spaces, dashes, parentheses and a
# leading "+" are all accepted; the `tel:` href is generated from the digits.
#
# There is deliberately NO default compiled into the bundle. When this is
# missing (or set to a placeholder such as 0000-000-000) every surface shows
# the email fallback instead of a dead number, so set it per environment.
VITE_SUPPORT_PHONE=

# Optional explicit formatting for the link text, e.g. "+974 7726 4007".
# Omit to let the app group the digits itself.
VITE_SUPPORT_PHONE_DISPLAY=

# Shown in the fallback message when VITE_SUPPORT_PHONE is not configured.
VITE_SUPPORT_EMAIL=care@jachiandmuchi.com
